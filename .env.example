# Noir Café — environment
# Copy to .env.local for development; set the same keys in Vercel for deploys.
# Every key is optional: without one, its feature degrades gracefully.
# GET /api/health reports which integrations are switched on (never the values).
# Never commit real values — .env* files other than this template are git-ignored.

# ── Site ─────────────────────────────────────────────────────────────────
# Canonical origin, e.g. https://www.noircafe.com. Used for canonical URLs,
# hreflang, Open Graph, the sitemap, JSON-LD and payment redirects; when it is
# https the site also sends HSTS and upgrade-insecure-requests.
NEXT_PUBLIC_SITE_URL=
# Search Console ownership token (the content of the google-site-verification meta tag).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# ── AI barista-concierge (/concierge) ─────────────────────────────────────
# Server-only. Without it the concierge shows as "resting".
ANTHROPIC_API_KEY=
# Optional model override (default: claude-opus-5-5).
CONCIERGE_MODEL=

# ── Ordering (/order) ────────────────────────────────────────────────────
# Supabase — persists orders, live availability, synced favourites.
# Schema: supabase/migrations. The service-role key is server-only.
# The project URL may be given as either name. The anon key is not needed:
# every query runs on the server with the service-role key.
SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe — enables "Pay now" (Checkout). Without it, orders are paid at pickup.
STRIPE_SECRET_KEY=
# Webhook signing secret for /api/stripe/webhook (marks orders paid).
STRIPE_WEBHOOK_SECRET=

# Clerk — optional sign-in; favourites sync to the account.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# ── Reservations (/reservation) ─────────────────────────────────────────
# Confirmation emails via Resend (HTTP API). Without them, no email is sent.
RESEND_API_KEY=
# Verified sender, e.g. "Noir Café <reservations@noircafe.com>"
RESERVATIONS_FROM=

# ── PWA push notifications ────────────────────────────────────────────
# Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@noircafe.com
# Bearer token for POST /api/push/send (the cafe's own tools).
PUSH_ADMIN_TOKEN=

# ── Analytics (all off until set; all skip visitors with GPC / Do Not Track) ─
# Vercel Web Analytics — enable it in the Vercel project, then set to 1.
NEXT_PUBLIC_VERCEL_ANALYTICS=
# Plausible — the site's domain as registered in Plausible.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
# Self-hosted Plausible script URL (default https://plausible.io/js/script.js).
NEXT_PUBLIC_PLAUSIBLE_SRC=
# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX.
NEXT_PUBLIC_GA_ID=

# ── Deploy (CI only — not read by the app) ───────────────────────────────
# Token for `vercel deploy` from CI. Keep it in the CI secret store, not here.
# VERCEL_TOKEN=
